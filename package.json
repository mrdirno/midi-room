{
  "name": "midi-room",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Six local browser music instruments with optional MIDI hardware and account-free feedback.",
  "scripts": {
    "build": "python3 src/build-slice.py",
    "portable": "python3 src/build-slice.py",
    "test": "node --test tests/*.test.mjs && node src/triton/triton.test.cjs && node --test src/lucky-cloud/tests/contracts.test.cjs",
    "test:browser": "node tools/production-browser-check.mjs",
    "test:lifecycle": "node tools/production-lifecycle-check.mjs",
    "test:offline": "node tools/production-offline-check.mjs",
    "test:lucky:audio": "node src/lucky-cloud/tests/render-evaluation.cjs",
    "test:csp": "node tools/production-csp-check.mjs",
    "test:header": "node tools/production-header-check.mjs",
    "test:lucky:contracts": "node --test src/lucky-cloud/tests/contracts.test.cjs",
    "test:lucky:locks": "node src/lucky-cloud/tests/locked-drum-pcm.cjs",
    "test:lucky:browser": "node src/lucky-cloud/tests/browser-check.cjs",
    "test:lucky:legacy": "node --test src/lucky/tests/*.test.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
