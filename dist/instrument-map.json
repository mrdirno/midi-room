    "triangle": ["tamb", "shaker", "hatC"],
    "surdo": ["handDrumLow", "tomL"]
  },
  "instruments": {
    "lucky-dreamer": {
      "name": "Lucky Dreamer",
      "sends": {
        "percussion": {
          "channel": 9,
          "notes": {
            "36": "kick", "37": "rim", "38": "snare", "39": "clap", "41": "tomL",
            "42": "hatC", "45": "tomM", "46": "hatO", "48": "tomH", "49": "crash",
            "51": "ride", "54": "tamb", "56": "cowbell", "60": "bongoH", "61": "bongoL",
            "62": "congaH", "63": "congaM", "64": "congaL", "65": "timbH", "66": "timbL",
            "67": "agogoH", "68": "agogoL", "69": "cabasa", "70": "shaker", "74": "guiro",
            "75": "clave", "76": "woodblk", "81": "triangle"
          },
          "shared_notes": {
            "41": ["tomL", "surdo"],
            "62": ["congaH", "djembeS"],
            "63": ["congaM", "djembeT"],
            "64": ["congaL", "djembeB", "dunL", "dunM", "dunS"],
            "65": ["timbH", "talking"],
            "70": ["shaker", "shake"]
          },
          "audit": "Lucky Dreamer names 37 drum slots but publishes only 28 note numbers, so six numbers carry more than one drum and the map has to pick one reading. Measured over 460 bands: 32.6% of its channel-9 hits are on a shared number. Separately, its percussion slot list has 25 names against 22 notes, so dunL, dunM and dunS are all published as note 64 (the live generator never picks dunL) and arrive as a low conga. Both are sender defects; a translation downstream cannot undo them. Two rows, 60 and 61, describe drums the shipped generator never selects; they are kept because the sender table does list them, so a future style that uses one already translates."
        },
        "pitched": {
          "channels": [0, 1, 2, 3],
          "range": [22, 93],
          "stable_lanes": false,
          "audit": "The pitched channel number is a counter over roster order, not a lane name: channel 0 is the 808 in a style that has one and the keys in a style that does not, and muting a lane slides every later lane down. Pitch translation does not need the lane, so this does not block a cable; naming the lane from the channel would be wrong about half the time."
        }
      },
      "receives": null
    },
