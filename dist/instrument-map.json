                "tomM": 43, "tomH": 45, "hatO": 46, "crash": 47
              }
            },
            {
              "name": "perc",
              "notes": [48, 59],
              "slots": {
                "handDrumLow": 48, "handSlap": 50, "clave": 51, "cowbell": 52,
                "handDrumMid": 53, "shaker": 54, "handDrumHigh": 55, "bongo": 57, "tamb": 58
              }
            }
          ]
        },
        "pitched": { "range": [0, 127] }
      }
    },
    "drum-pad": {
      "name": "Drum Pad",
      "sends": {
        "percussion": {
          "channel": 9,
          "notes": {
            "36": "kick", "38": "snare", "39": "clap", "41": "tomL", "42": "hatC",
            "43": "tomM", "45": "tomH", "46": "hatO", "47": "crash"
          }
        },
        "pitched": null
      },
      "receives": {
        "percussion": {
          "channel": 9,
          "kits": [
            {
              "name": "pads",
              "notes": [36, 44],
              "slots": {
                "kick": 36, "snare": 37, "clap": 38, "tomL": 39, "hatC": 40,
                "tomM": 41, "tomH": 42, "hatO": 43, "crash": 44
              }
            }
          ]
        },
        "pitched": null,
        "audit": "Drum Pad's incoming window is a dense sixteen-note run from 36, so only note 36 means the same thing coming in as going out. It matches a note-on by note number alone but a note-off by input, channel and note together, so a translation that rewrites the channel of one half and not the other leaves notes held; at 128 held the pad stops responding to its own touch."
      }
    },
    "field-keys": {
      "name": "Field Keys",
      "sends": null,
      "receives": {
        "percussion": null,
        "pitched": { "range": [0, 127] },
        "audit": "Field Keys has no percussion engine and no note vocabulary: every note number sounds a bell at its equal-tempered pitch. A drum kit cabled into it arrives as a chord of low bells, which is why percussion is declared null rather than mapped."
      }
    },
    "dsp-rack": {
      "name": "DSP Rack",
      "sends": null,
      "receives": {
        "percussion": null,
        "pitched": { "range": [23, 95] },
        "audit": "The playable window is derived per rack from the loaded module's frequency bounds; 23 to 95 is the shipped Bloom Oscillator rack. One voice, last note wins, so a drum part cabled in silences the melody."
      }
    }
  }
